{
    "name": "arui-presets-lint",
    "version": "11.7.0",
    "description": "Config files for arui-apps",
    "author": "core-ds contributors",
    "license": "MIT",
    "type": "module",
    "bin": "cli/index.mjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/arui-presets-lint.git"
    },
    "dependencies": {
        "@alfalab/stylelint-core-vars": "workspace:*",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@eslint/js": "10.0.1",
        "@eslint/json": "2.1.1",
        "@eslint/markdown": "8.0.3",
        "@prettier/plugin-oxc": "0.2.3",
        "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
        "@typescript-eslint/utils": "8.72.1",
        "eslint": "10.14.0",
        "eslint-config-flat-gitignore": "2.4.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-check-file": "3.3.2",
        "eslint-plugin-de-morgan": "2.3.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsx-a11y-x": "0.2.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-react-dom": "5.28.8",
        "eslint-plugin-react-jsx": "5.28.8",
        "eslint-plugin-react-x": "5.28.8",
        "eslint-plugin-react-you-might-not-need-an-effect": "1.0.3",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-unicorn": "79.0.0",
        "execa": "^10.2.0",
        "globals": "^17.0.0",
        "jiti": "^2.6.1",
        "knip": "6.44.1",
        "lefthook": "2.2.2",
        "prettier": "3.9.10",
        "secretlint": "13.1.0",
        "stylelint": "17.16.0",
        "stylelint-order": "8.1.2",
        "typescript-eslint": "8.72.1"
    },
    "engines": {
        "node": "^22.13.0 || >=24.0.0"
    },
    "devDependencies": {
        "@alfalab/core-components": "50.38.0",
        "@commitlint/types": "21.2.3",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@vitest/coverage-istanbul": "5.0.5",
        "concurrently": "10.0.6",
        "copyfiles": "2.4.1",
        "es-toolkit": "1.53.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-vitest-rule-tester": "3.2.0",
        "react": "19.3.1",
        "rimraf": "6.1.3",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json && copyfiles 'lefthook/*.yml' '**/*.md' dist && tsx _internal/build-dist-package.ts",
        "test": "concurrently \"tsc --noEmit\" \"eslint-config-prettier ./eslint/index.ts\" \"tsx _internal/duplicates-checker.ts\" yarn:lint yarn:test:unit",
        "test:unit": "vitest --run --coverage",
        "lint": "concurrently yarn:lint:styles yarn:lint:scripts yarn:format:check",
        "lint:fix": "yarn lint:styles --fix && yarn lint:scripts --fix && yarn format",
        "lint:styles": "tsx ./cli/index.mts styles",
        "lint:scripts": "tsx ./cli/index.mts scripts --concurrency off",
        "format": "tsx ./cli/index.mts format",
        "format:check": "tsx ./cli/index.mts format:check"
    },
    "exports": {
        "./eslint": "./eslint/index.ts",
        "./eslint/config": "./eslint/config.ts",
        "./eslint/rules": "./eslint/rules/index.ts",
        "./eslint/plugins": "./eslint/plugins/index.ts",
        "./prettier": {
            "types": "./prettier/index.d.ts",
            "import": "./prettier/index.js"
        },
        "./commitlint": "./commitlint/index.ts",
        "./stylelint": "./stylelint/index.ts",
        "./knip": "./knip/index.ts"
    },
    "publishConfig": {
        "directory": "dist",
        "access": "public"
    },
    "commitlint": {
        "extends": "./commitlint/index.ts"
    },
    "stylelint": {
        "extends": "./stylelint/index.ts"
    },
    "prettier": "./prettier/index.js"
}
