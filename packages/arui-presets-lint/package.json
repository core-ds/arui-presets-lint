{
    "name": "arui-presets-lint",
    "version": "11.2.0",
    "description": "Config files for arui-apps",
    "author": "core-ds contributors",
    "license": "MIT",
    "type": "module",
    "bin": "cli/index.mjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/arui-presets-lint.git"
    },
    "dependencies": {
        "@alfalab/stylelint-core-vars": "workspace:*",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@eslint/js": "9.39.5",
        "@eslint/json": "2.1.0",
        "@eslint/markdown": "8.0.3",
        "@prettier/plugin-oxc": "0.2.3",
        "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
        "@types/eslint-plugin-jsx-a11y": "6.10.1",
        "@typescript-eslint/parser": "8.70.0",
        "@typescript-eslint/utils": "8.70.0",
        "eslint": "9.39.5",
        "eslint-config-flat-gitignore": "2.4.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-check-file": "3.3.2",
        "eslint-plugin-de-morgan": "2.1.3",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-unicorn": "65.0.1",
        "execa": "^9.6.1",
        "globals": "^17.0.0",
        "jiti": "^2.6.1",
        "knip": "6.36.0",
        "lefthook": "2.1.14",
        "prettier": "3.9.7",
        "secretlint": "13.0.5",
        "stylelint": "17.15.0",
        "stylelint-order": "8.1.1",
        "typescript-eslint": "8.70.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "devDependencies": {
        "@alfalab/core-components": "50.31.0",
        "@commitlint/types": "21.2.0",
        "@types/node": "24.13.5",
        "@types/react": "19.3.0",
        "@vitest/coverage-istanbul": "5.0.1",
        "copyfiles": "2.4.1",
        "es-toolkit": "1.52.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-vitest-rule-tester": "3.2.0",
        "react": "19.3.0",
        "rimraf": "6.1.3",
        "tsx": "4.23.13",
        "typescript": "6.0.3",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json && copyfiles 'lefthook/*.yml' '**/*.md' dist && tsx _internal/build-dist-package.ts",
        "test": "tsc --noEmit && eslint-config-prettier ./eslint/index.ts && tsx _internal/duplicates-checker.ts && yarn lint && yarn test:unit",
        "test:unit": "vitest --run --coverage",
        "lint": "yarn lint:styles && yarn lint:scripts && yarn format:check",
        "lint:fix": "yarn lint:styles --fix && yarn lint:scripts --fix && yarn format",
        "lint:styles": "tsx ./cli/index.mts styles",
        "lint:scripts": "tsx ./cli/index.mts scripts",
        "format": "tsx ./cli/index.mts format",
        "format:check": "tsx ./cli/index.mts format:check"
    },
    "exports": {
        "./eslint": "./eslint/index.ts",
        "./eslint/config": "./eslint/config.ts",
        "./eslint/rules": "./eslint/rules/index.ts",
        "./eslint/plugins": "./eslint/plugins/index.ts",
        "./prettier": {
            "types": "./prettier/index.d.ts",
            "import": "./prettier/index.js"
        },
        "./commitlint": "./commitlint/index.ts",
        "./stylelint": "./stylelint/index.ts",
        "./knip": "./knip/index.ts"
    },
    "publishConfig": {
        "directory": "dist",
        "access": "public"
    },
    "commitlint": {
        "extends": "./commitlint/index.ts"
    },
    "stylelint": {
        "extends": "./stylelint/index.ts"
    },
    "prettier": "./prettier/index.js"
}
