{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!test/**"],
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"],
        },
        "test:unit": {
            "outputs": ["coverage/**"],
        },
        // stylelint подключает @alfalab/stylelint-core-vars,
        // экспорты которого указывают на dist — без сборки зависимости плагин не резолвится
        "lint": {
            "dependsOn": ["^build"],
        },
        "lint:fix": {
            "cache": false,
        },
        "format": {
            "cache": false,
        },
        "format:check": {},
    },
}
